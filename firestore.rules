rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{code} {
      function signedIn() {
        return request.auth != null && code.matches('^[0-9]{6}$');
      }
      function open() {
        return resource.data.version == 1
          && resource.data.expiresAt > request.time;
      }
      function description(value, type) {
        return value is map && value.keys().hasOnly(['type', 'sdp'])
          && value.type == type && value.sdp is string
          && value.sdp.size() > 0 && value.sdp.size() <= 65536;
      }
      function candidate(value) {
        return value is map
          && value.keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex'])
          && value.candidate is string && value.candidate.size() <= 4096
          && (value.sdpMid == null || value.sdpMid is string)
          && (value.sdpMLineIndex == null || value.sdpMLineIndex is int);
      }
      function appendCandidate(field) {
        let before = resource.data[field];
        let after = request.resource.data[field];
        return after is list && after.size() <= 128
          && after.size() == before.size() + 1 && after.hasAll(before)
          && candidate(after[before.size()]);
      }
      // The code is an invitation capability: exact lookup is allowed so a
      // guest can join and a host can check collisions. Collection listing is not.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'version', 'session', 'hostUid', 'guestUid', 'createdAt', 'expiresAt',
          'offer', 'answer', 'hostCandidates', 'guestCandidates'
        ])
        && request.resource.data.version == 1
        && request.resource.data.session is string
        && request.resource.data.session.matches('^[a-f0-9]{32}$')
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.guestUid == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(2, 'h')
        && request.resource.data.offer == null
        && request.resource.data.answer == null
        && request.resource.data.hostCandidates == []
        && request.resource.data.guestCandidates == [];
      allow update: if signedIn() && open() && (
        // Claim exactly one guest slot, without changing any other field.
        (resource.data.guestUid == null
          && request.auth.uid != resource.data.hostUid
          && request.resource.data.guestUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['guestUid']))
        || (request.auth.uid == resource.data.hostUid && (
          (resource.data.offer == null
            && description(request.resource.data.offer, 'offer')
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['offer']))
          || (appendCandidate('hostCandidates')
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['hostCandidates']))
        ))
        || (request.auth.uid == resource.data.guestUid && (
          (resource.data.answer == null && resource.data.offer != null
            && description(request.resource.data.answer, 'answer')
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['answer']))
          || (appendCandidate('guestCandidates')
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['guestCandidates']))
        ))
      );
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
    }

    // Open-world bombs. Durations mirror lib/services/bomb_service.dart.
    // Clients write timestamps with serverTimestamp(), so request.time is the
    // only clock trusted here. The 50 m claim radius is client-side only.
    match /bombs/{bombId} {
      function uid() {
        return request.auth.uid;
      }
      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      function bombLive(bomb) {
        return bomb.active == true
          && bomb.createdAt + duration.value(24, 'h') > request.time;
      }
      function leaseActive(bomb) {
        return bomb.claimedAt + duration.value(10, 'm') > request.time;
      }
      // Each player owns three slots ({uid}_0..2), which caps live bombs.
      function ownSlot() {
        return bombId.matches(uid() + '_[0-2]');
      }
      function freshBomb() {
        let bomb = request.resource.data;
        let keys = ['lat', 'lng', 'geohash', 'plantedBy', 'status', 'active',
          'claimedBy', 'claimedAt', 'createdAt'];
        return bomb.keys().hasAll(keys) && bomb.keys().hasOnly(keys)
          && bomb.lat is number && bomb.lat >= -90 && bomb.lat <= 90
          && bomb.lng is number && bomb.lng >= -180 && bomb.lng <= 180
          && bomb.geohash is string
          && bomb.geohash.matches('[0-9b-hjkmnp-z]{9}')
          && bomb.plantedBy == uid()
          && bomb.status == 'armed'
          && bomb.active == true
          && bomb.claimedBy == null
          && bomb.claimedAt == null
          && bomb.createdAt == request.time;
      }
      // A slot is reused once its bomb is resolved or expired.
      function replant() {
        return ownSlot() && !bombLive(resource.data) && freshBomb();
      }
      // Anyone but the planter may lock a free bomb for one game.
      function claim() {
        let before = resource.data;
        let after = request.resource.data;
        return before.plantedBy != uid()
          && bombLive(before)
          && (before.status == 'armed'
            || (before.status == 'claimed' && !leaseActive(before)))
          && changedKeys().hasOnly(['status', 'claimedBy', 'claimedAt'])
          && after.status == 'claimed'
          && after.claimedBy == uid()
          && after.claimedAt == request.time;
      }
      // An expired lease still counts until another player claims the bomb.
      function heldByCaller() {
        return resource.data.status == 'claimed'
          && resource.data.claimedBy == uid();
      }
      function abandon() {
        let after = request.resource.data;
        return heldByCaller()
          && changedKeys().hasOnly(['status', 'claimedBy', 'claimedAt'])
          && after.status == 'armed'
          && after.claimedBy == null
          && after.claimedAt == null;
      }
      function resolve() {
        let after = request.resource.data;
        return heldByCaller()
          && changedKeys().hasOnly(['status', 'active', 'resolvedBy',
            'resolvedAt'])
          && after.status in ['defused', 'exploded']
          && after.active == false
          && after.resolvedBy == uid()
          && after.resolvedAt == request.time;
      }

      allow get, list: if request.auth != null;
      allow create: if request.auth != null && ownSlot() && freshBomb();
      allow update: if request.auth != null
        && (replant() || claim() || abandon() || resolve());
      allow delete: if false;
    }
  }
}
